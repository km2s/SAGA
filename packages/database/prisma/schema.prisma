generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Usuário ───────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  CampaignMember[]
  notes        Note[]
  systems      RPGSystem[]
  applications CampaignApplication[]
}

// ─── Campanha ──────────────────────────────────────────────

model Campaign {
  id                String   @id @default(cuid())
  name              String
  description       String?  @db.Text
  theme             String?
  systemId          String?
  guildId           String?
  campaignType      String   @default("campaign")
  contentTone       String?
  playStyle         String?
  sessionFrequency  String?
  minExperience     String?
  isOpen            Boolean  @default(false)
  maxSlots          Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  system       RPGSystem?            @relation(fields: [systemId], references: [id])
  members      CampaignMember[]
  npcs         NPC[]
  sessions     Session[]
  notes        Note[]
  handouts     Handout[]
  applications CampaignApplication[]
}

model CampaignApplication {
  id              String   @id @default(cuid())
  campaignId      String
  userId          String
  characterDesc   String   @default("") @db.Text
  experienceLevel String
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId])
}

enum MemberRole {
  GM
  PLAYER
}

model CampaignMember {
  id          String     @id @default(cuid())
  role        MemberRole
  joinedAt    DateTime   @default(now())
  lastSeenAt  DateTime?

  userId     String
  campaignId String

  user     User     @relation(fields: [userId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  character       CharacterSheet?
  linkedNpcs      NPC[]           @relation("NPCLinkedMember")
  npcVisibilities NPCVisibility[]
  handoutsShared  Handout[]
  handoutViews    HandoutView[]

  @@unique([userId, campaignId])
  @@index([campaignId])
  @@index([userId])
}

// ─── Sistema de RPG ────────────────────────────────────────

model RPGSystem {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  category    String   @default("custom")
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())

  creatorId   String?
  creator     User?    @relation(fields: [creatorId], references: [id])

  attributes  SystemAttribute[]
  campaigns   Campaign[]
}

model SystemAttribute {
  id          String  @id @default(cuid())
  name        String
  defaultDie  String  // "d20", "2d6"
  description String?
  systemId    String

  system              RPGSystem            @relation(fields: [systemId], references: [id])
  characterAttributes CharacterAttribute[]
  npcAttributes       NPCAttribute[]
}

// ─── Ficha do Jogador ──────────────────────────────────────

model CharacterSheet {
  id        String   @id @default(cuid())
  name      String
  race      String?
  class     String?
  level     Int      @default(1)
  imageUrl  String?
  hp        Int      @default(0)
  maxHp     Int      @default(0)
  isPublic  Boolean  @default(false)
  memberId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member     CampaignMember       @relation(fields: [memberId], references: [id])
  attributes CharacterAttribute[]
  textFields CharacterTextField[]
  weapons    CharacterWeapon[]
  spellSlots CharacterSpellSlot[]
}

model CharacterAttribute {
  id          String  @id @default(cuid())
  value       Int     @default(0)
  customDie   String?
  sheetId     String
  attributeId String

  sheet     CharacterSheet  @relation(fields: [sheetId], references: [id])
  attribute SystemAttribute @relation(fields: [attributeId], references: [id])

  @@unique([sheetId, attributeId])
}

model CharacterTextField {
  id      String @id @default(cuid())
  sheetId String
  key     String
  label   String
  value   String @default("") @db.Text
  order   Int    @default(0)

  sheet CharacterSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, key])
  @@index([sheetId])
}

model CharacterWeapon {
  id          String  @id @default(cuid())
  sheetId     String
  name        String
  attackBonus String?
  damage      String?
  damageType  String?
  range       String?
  properties  String?
  order       Int     @default(0)

  sheet CharacterSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
}

model CharacterSpellSlot {
  id      String @id @default(cuid())
  sheetId String
  level   Int
  total   Int    @default(0)
  used    Int    @default(0)

  sheet CharacterSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, level])
  @@index([sheetId])
}

// ─── NPC ───────────────────────────────────────────────────

model NPC {
  id             String   @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  type           String   @default("NEUTRAL")
  race           String?
  class          String?
  level          Int      @default(1)
  hp             Int      @default(0)
  maxHp          Int      @default(0)
  isPublic       Boolean  @default(false)
  campaignId     String
  linkedMemberId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign     Campaign        @relation(fields: [campaignId], references: [id])
  linkedMember CampaignMember? @relation("NPCLinkedMember", fields: [linkedMemberId], references: [id])
  attributes   NPCAttribute[]
  textFields   NPCTextField[]
  visibilities NPCVisibility[]

  @@index([campaignId])
}

model NPCAttribute {
  id          String  @id @default(cuid())
  value       Int     @default(0)
  customDie   String?
  npcId       String
  attributeId String

  npc       NPC             @relation(fields: [npcId], references: [id])
  attribute SystemAttribute @relation(fields: [attributeId], references: [id])

  @@unique([npcId, attributeId])
}

model NPCTextField {
  id    String @id @default(cuid())
  npcId String
  key   String
  label String
  value String @default("")
  order Int    @default(0)

  npc NPC @relation(fields: [npcId], references: [id], onDelete: Cascade)

  @@unique([npcId, key])
  @@index([npcId])
}

model NPCVisibility {
  id       String  @id @default(cuid())
  canView  Boolean @default(false)
  npcId    String
  memberId String

  npc    NPC            @relation(fields: [npcId], references: [id])
  member CampaignMember @relation(fields: [memberId], references: [id])

  @@unique([npcId, memberId])
}

// ─── Sessão ────────────────────────────────────────────────

model Session {
  id             String    @id @default(cuid())
  name           String?
  isActive       Boolean   @default(true)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  campaignId     String
  tokensJson      String?
  musicYoutubeId  String?
  musicVolume     Int       @default(50)
  mapImageUrl     String?
  liveMembersJson String?
  markersJson     String?

  campaign Campaign        @relation(fields: [campaignId], references: [id])
  rollLogs RollLog[]
  summary  SessionSummary?

  @@index([campaignId, isActive])
}

model RollLog {
  id         String   @id @default(cuid())
  expression String
  rolls      Json
  modifier   Int      @default(0)
  total      Int
  attribute  String?
  rolledBy   String
  rolledAt   DateTime @default(now())
  sessionId  String

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId, rolledAt(sort: Desc)])
}

model SessionSummary {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  sessionId String   @unique

  session Session @relation(fields: [sessionId], references: [id])
}

// ─── Handouts ──────────────────────────────────────────────

model Handout {
  id          String   @id @default(cuid())
  title       String?
  content     String?
  imageUrl    String?
  campaignId  String
  sharedById  String
  createdAt   DateTime @default(now())

  campaign Campaign        @relation(fields: [campaignId], references: [id])
  sharedBy CampaignMember  @relation(fields: [sharedById], references: [id])
  seenBy   HandoutView[]

  @@index([campaignId])
}

model HandoutView {
  id         String   @id @default(cuid())
  handoutId  String
  memberId   String
  seenAt     DateTime @default(now())

  handout Handout        @relation(fields: [handoutId], references: [id])
  member  CampaignMember @relation(fields: [memberId], references: [id])

  @@unique([handoutId, memberId])
}

// ─── Notas ─────────────────────────────────────────────────

enum NoteVisibility {
  PRIVATE
  CAMPAIGN
  GM_ONLY
}

model Note {
  id         String         @id @default(cuid())
  title      String?
  content    String
  visibility NoteVisibility @default(PRIVATE)
  authorId   String
  campaignId String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  author   User     @relation(fields: [authorId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, visibility])
}
